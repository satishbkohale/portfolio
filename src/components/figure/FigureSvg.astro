---
/**
 * Static SVG rendering of the zero-trust figure for one layout.
 * Styling is entirely class-based (src/styles/figure.css); no style attributes,
 * so it works under `style-src 'self'`. Hidden from assistive technology:
 * the parent <figure> provides the text equivalent.
 */
import {
  borderPoint,
  center,
  edges,
  nodeById,
  nodes,
  planes,
  type Rect,
  type TopoNode,
  viewBox,
} from '../../data/topology';

interface Props {
  layout: 'wide' | 'tall';
  /** Unique prefix for marker ids (several SVGs can share a page). */
  uid: string;
}

const { layout, uid } = Astro.props;
const vb = viewBox[layout];
const p = planes[layout];
const markerId = `${uid}-${layout}-arrow`;

const font = layout === 'wide' ? { size: 16, line: 19 } : { size: 13, line: 15 };

function labelLines(n: TopoNode): string[] {
  return layout === 'tall' && n.tallLabel ? n.tallLabel : n.label;
}

function textY(r: Rect, lines: number): number {
  const c = center(r);
  // Vertically centre the block of lines; 0.35em approximates the cap-height offset.
  return c.y - ((lines - 1) * font.line) / 2 + font.size * 0.35;
}

// In the tall layout the eight converging lines would collide with the input
// grid, so inputs connect through one bus instead.
const drawnEdges = edges
  .filter((e) => layout === 'wide' || e.kind !== 'signal')
  .map((e) => {
    const a = nodeById.get(e.from);
    const b = nodeById.get(e.to);
    if (!a || !b) throw new Error(`Unknown edge ${e.from} -> ${e.to}`);
    const ra = a[layout];
    const rb = b[layout];
    const ca = center(ra);
    const cb = center(rb);
    // Inputs connect to the side of the policy engine (as the arrows in NIST
    // Fig. 2 enter the control plane from the sides), so lines never cross
    // the policy administrator below it.
    const toEngineSide = e.kind === 'signal' && e.to === 'engine';
    const p2 = toEngineSide ? { x: ca.x < cb.x ? rb.x : rb.x + rb.w, y: cb.y } : borderPoint(rb, ca.x, ca.y);
    const p1 = toEngineSide ? { x: ca.x < cb.x ? ra.x + ra.w : ra.x, y: ca.y } : borderPoint(ra, p2.x, p2.y);
    return { ...e, channel: a.kind === 'input' ? a.channel : 'core', x1: p1.x, y1: p1.y, x2: p2.x, y2: p2.y };
  });

const glyph = (n: TopoNode) => {
  const r = n[layout];
  return { x: r.x + 9, y: r.y + 9 };
};
---

<svg
  class={`fig-svg fig-svg--${layout}`}
  viewBox={`0 0 ${vb.w} ${vb.h}`}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <marker id={markerId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path class="fig-arrowhead" d="M0 0 L10 5 L0 10 z"></path>
    </marker>
  </defs>

  <!-- Planes -->
  <rect class="fig-frame" x={p.frame.x} y={p.frame.y} width={p.frame.w} height={p.frame.h} rx="18"></rect>
  <line class="fig-divider" x1={p.frame.x} x2={p.frame.x + p.frame.w} y1={p.divider} y2={p.divider}></line>
  <rect class="fig-pdp" x={p.pdp.x} y={p.pdp.y} width={p.pdp.w} height={p.pdp.h} rx="10"></rect>
  {
    layout === 'wide' ? (
      <g class="fig-plane-labels">
        <text class="fig-plane-label" x={p.frame.x + 16} y={p.frame.y + 26}>Control plane</text>
        <text class="fig-plane-label" x={p.frame.x + p.frame.w - 16} y={p.frame.y + p.frame.h - 14} text-anchor="end">
          Data plane
        </text>
        <text class="fig-plane-label fig-plane-label--pdp" x={p.pdp.x + p.pdp.w / 2} y={p.pdp.y + p.pdp.h - 12} text-anchor="middle">
          Policy decision point
        </text>
      </g>
    ) : (
      <g class="fig-plane-labels">
        <text class="fig-plane-label" x={p.pdp.x + p.pdp.w / 2} y={p.pdp.y + p.pdp.h - 8} text-anchor="middle">
          Policy decision point (control plane)
        </text>
        <text class="fig-plane-label" x={p.frame.x + p.frame.w - 10} y={p.divider + 12} text-anchor="end">
          Data plane
        </text>
      </g>
    )
  }

  <!-- Edges -->
  <g class="fig-edges">
    {
      drawnEdges.map((e) => (
        <line
          class="fig-edge"
          data-kind={e.kind}
          data-channel={e.channel}
          data-from={e.from}
          data-to={e.to}
          x1={e.x1.toFixed(1)}
          y1={e.y1.toFixed(1)}
          x2={e.x2.toFixed(1)}
          y2={e.y2.toFixed(1)}
          marker-end={`url(#${markerId})`}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
    {
      layout === 'tall' && (
        <g class="fig-bus">
          <line class="fig-edge" data-kind="signal" data-channel="core" x1="92" y1="200" x2="92" y2="212" vector-effect="non-scaling-stroke" />
          <line class="fig-edge" data-kind="signal" data-channel="core" x1="267" y1="200" x2="267" y2="212" vector-effect="non-scaling-stroke" />
          <line class="fig-edge" data-kind="signal" data-channel="core" x1="92" y1="212" x2="267" y2="212" vector-effect="non-scaling-stroke" />
          <line
            class="fig-edge"
            data-kind="signal"
            data-channel="core"
            x1="95"
            y1="212"
            x2="95"
            y2="236"
            marker-end={`url(#${markerId})`}
            vector-effect="non-scaling-stroke"
          />
        </g>
      )
    }
  </g>

  <!-- Nodes -->
  <g class="fig-nodes">
    {
      nodes.map((n) => {
        const r = n[layout];
        const c = center(r);
        const lines = labelLines(n);
        const g = glyph(n);
        return (
          <g class="fig-node" data-node={n.id} data-kind={n.kind} data-channel={n.channel}>
            <rect class="fig-node__box" x={r.x} y={r.y} width={r.w} height={r.h} rx="4" vector-effect="non-scaling-stroke" />
            {n.channel === 'policy' && <rect class="fig-glyph" x={g.x - 4} y={g.y - 4} width="8" height="8" />}
            {n.channel === 'identity' && <circle class="fig-glyph" cx={g.x} cy={g.y} r="4.5" />}
            {n.channel === 'activity' && (
              <path class="fig-glyph" d={`M${g.x} ${g.y - 5} L${g.x + 5} ${g.y + 4} L${g.x - 5} ${g.y + 4} Z`} />
            )}
            <text class="fig-node__label" x={c.x} y={textY(r, lines.length)} text-anchor="middle">
              {lines.map((line, i) => (
                <tspan x={c.x} dy={i === 0 ? 0 : font.line}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        );
      })
    }
  </g>
</svg>
