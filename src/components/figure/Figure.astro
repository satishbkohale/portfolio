---
/**
 * The zero-trust figure.
 *
 * Static tier: two SVG layouts (wide/tall) chosen by CSS media queries.
 * 3D tier: src/scripts/figure.ts may mount a WebGL canvas into the stage on
 * capable desktops; the SVG stays underneath as the poster and fallback.
 *
 * data-active  = channel emphasised (policy | identity | activity | none)
 * data-beat    = story step (0-4), set by scroll in the "story" variant
 */
import type { ChannelId } from '../../data/roles';
import { roles } from '../../data/roles';
import { channels, figureDescription, nodes } from '../../data/topology';
import FigureSvg from './FigureSvg.astro';

interface Props {
  variant: 'hero' | 'story';
  /** Channel emphasised by default (role pages). */
  emphasis?: ChannelId | undefined;
}

const { variant, emphasis } = Astro.props;
const uid = `fig-${variant}`;
const inputsOf = (c: ChannelId) =>
  nodes
    .filter((n) => n.kind === 'input' && n.channel === c)
    .map((n) => n.label.join(' '))
    .join(', ');
const roleOf: Record<ChannelId, string> = { policy: roles.grc.short, identity: roles.iam.short, activity: roles.soc.short };
---

<figure
  class={`fig fig--${variant}`}
  data-figure={variant}
  data-active={emphasis ?? 'none'}
  data-default-active={emphasis ?? 'none'}
  data-beat="0"
  data-tier="static"
  aria-labelledby={`${uid}-caption`}
>
  <div class="fig__stage" data-scene-slot={variant}>
    <FigureSvg layout="wide" uid={uid} />
    <FigureSvg layout="tall" uid={uid} />
  </div>

  <p class="visually-hidden">{figureDescription}</p>

  <figcaption class="fig__caption" id={`${uid}-caption`}>
    {
      variant === 'hero' ? (
        <span class="fig__text">
          <span class="fig__num">Fig. 1</span> The access decision: core zero trust components, simplified from <cite>NIST SP 800-207</cite>, Fig. 2.
        </span>
      ) : (
        <span class="fig__text">
          <span class="fig__num">Fig. 2</span> The same components, step by step. Simplified from <cite>NIST SP 800-207</cite>, Fig. 2; the grouping into three channels is mine.
        </span>
      )
    }
    <button class="motion-toggle" type="button" aria-pressed="true" data-motion-toggle hidden>
      <span class="motion-toggle__label">Motion</span>
      <span class="motion-toggle__state" data-motion-state aria-hidden="true">on</span>
    </button>
  </figcaption>

  {
    variant === 'story' && (
      <ul class="fig-legend" data-legend aria-label="Figure legend: the three channels">
        {channels.map((c) => (
          <li class="fig-legend__item" data-channel={c.id}>
            <span class="fig-legend__content" data-legend-content data-channel={c.id}>
              <svg class="fig-legend__glyph" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                {c.id === 'policy' && <rect x="2" y="2" width="8" height="8" />}
                {c.id === 'identity' && <circle cx="6" cy="6" r="4.5" />}
                {c.id === 'activity' && <path d="M6 1 L11 10 L1 10 Z" />}
              </svg>
              <span class="fig-legend__name">
                {c.label} <span class="fig-legend__role">({roleOf[c.id]})</span>
              </span>
              <span class="fig-legend__question">{c.question}</span>
              <span class="fig-legend__inputs">{inputsOf(c.id)}</span>
            </span>
          </li>
        ))}
      </ul>
    )
  }
</figure>
