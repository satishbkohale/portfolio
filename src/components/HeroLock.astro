---
/**
 * Hero figure box. The 3D scene (src/three/hero.ts) renders into this box;
 * two 2D pictures share it:
 *   packets  first paint on capable devices: the 3D opening pose (plaintext
 *            packets, open lock), generated by scripts/hero-poster.mjs from
 *            the same camera, so the canvas fades in with nothing moving
 *   flat     the line-drawn lock below: the role URLs' compact hero, weak
 *            devices, no WebGL, reduced motion, and the 3D fallback
 * data-mode on the box selects the picture (scripts/home.ts).
 *
 * A line-drawn padlock inside a slowly turning dial, with two
 * tilted orbits. Security terms travel along the orbits and pass in front of
 * and behind the lock (scripts/home.ts). Decorative: the page text carries the
 * meaning, so the whole figure is hidden from assistive technology.
 *
 * Motion: the lock draws itself once on load; the dial, orbit lights and tags
 * loop slowly. The "Animation" switch in the hero pauses every loop (WCAG
 * 2.2.2) and works without JavaScript through :has(). Reduced-motion users get
 * the finished, still figure.
 */

import poster from '../data/hero-poster.json';

interface Props {
  /** Compact hero on the role URLs: the flat lock with its 2D loops, no 3D. */
  compact?: boolean;
}
const { compact = false } = Astro.props;

/** Orbit geometry in viewBox units (0-100). scripts/home.ts reads the same data. */
const rings = [
  { rx: 31, ry: 10, tilt: -12, period: 70 },
  { rx: 46, ry: 16, tilt: 9, period: -95 },
];
/** Phases chosen so the opening pose is clean: no front label touches the
 *  lock or another label (labels behind the lock are hidden by it). */
const tags = [
  { label: 'MFA', ring: 0, phase: 0.445 },
  { label: 'PAM', ring: 0, phase: 0.785 },
  { label: 'SIEM', ring: 0, phase: 0.115 },
  { label: 'ISO 27001', ring: 1, phase: 0.398 },
  { label: 'MITRE ATT&CK', ring: 1, phase: 0.648 },
  { label: 'Zero Trust', ring: 1, phase: 0.898 },
  { label: 'NIST CSF', ring: 1, phase: 0.148 },
];

/** Ellipse as a path (pathLength is reliable on <path> in every engine). */
const ellipse = (rx: number, ry: number) => `M${50 - rx} 50a${rx} ${ry} 0 1 0 ${2 * rx} 0a${rx} ${ry} 0 1 0 ${-2 * rx} 0`;
---

<div
  class:list={['orbit', compact && 'orbit--compact']}
  data-orbit
  data-view={compact ? undefined : 'hero'}
  data-mode={compact ? 'flat' : 'packets'}
  data-rings={JSON.stringify(rings)}
  aria-hidden="true"
>
  <svg class="orbit__svg" viewBox="0 0 100 100" focusable="false">
    <defs>
      <radialGradient id="lock-glow">
        <stop offset="0" class="orbit__glow-in"></stop>
        <stop offset="1" class="orbit__glow-out"></stop>
      </radialGradient>
      <clipPath id="lock-body-clip">
        <path d="M42 48h16a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H42a3 3 0 0 1-3-3V51a3 3 0 0 1 3-3z"></path>
      </clipPath>
    </defs>

    <circle class="orbit__glow" cx="50" cy="52" r="30" fill="url(#lock-glow)"></circle>

    {
      rings.map((r, i) => (
        <g transform={`rotate(${r.tilt} 50 50)`}>
          <path class="orbit__path" d={ellipse(r.rx, r.ry)} />
          <path class={`orbit__light orbit__light--${i}`} d={ellipse(r.rx, r.ry)} pathLength="100" />
        </g>
      ))
    }

    <g class="orbit__dial">
      <circle class="orbit__ticks" cx="50" cy="51" r="19.5"></circle>
    </g>
    <circle class="orbit__ring" cx="50" cy="51" r="23"></circle>
    <g class="orbit__sweep">
      <circle class="orbit__arc" cx="50" cy="51" r="23" pathLength="100"></circle>
    </g>

    <g class="lock">
      <path class="lock__line lock__shackle" d="M43.5 48v-6a6.5 6.5 0 0 1 13 0v6" pathLength="1"></path>
      <path class="lock__line lock__body" d="M42 48h16a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H42a3 3 0 0 1-3-3V51a3 3 0 0 1 3-3z" pathLength="1"></path>
      <circle class="lock__key" cx="50" cy="55" r="1.7"></circle>
      <path class="lock__line lock__slot" d="M50 56.7v3.3" pathLength="1"></path>
      <g clip-path="url(#lock-body-clip)">
        <line class="lock__scan" x1="38" y1="48" x2="62" y2="48"></line>
      </g>
    </g>
  </svg>

  {
    !compact && (
      <svg class="orbit__packets" viewBox="0 0 100 100" focusable="false">
        <polyline class="packets__dial" points={poster.dial} />
        {poster.packets.map((pk) => (
          <g class="packets__packet">
            <polygon points={pk.points} />
            <text
              x={pk.x}
              y={pk.y}
              font-size={pk.size}
              textLength={pk.length}
              lengthAdjust="spacingAndGlyphs"
              transform={`rotate(${pk.angle} ${pk.x} ${pk.y})`}
            >
              {pk.text}
            </text>
          </g>
        ))}
        <polygon class="packets__body-back" points={poster.bodyBack} />
        <polygon class="packets__body" points={poster.body} />
        <polyline class="packets__shackle" points={poster.shackle} />
        <circle class="packets__key" cx={poster.keyhole.x} cy={poster.keyhole.y} r={poster.keyhole.r} />
      </svg>
    )
  }
  <ul class="orbit__tags">
    {
      tags.map((t) => (
        <li class="orbit__tag" data-ring={t.ring} data-phase={t.phase}>
          {t.label}
        </li>
      ))
    }
  </ul>
</div>
