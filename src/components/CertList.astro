---
/** Certifications and learning path, grouped by status. */
import type { RoleId } from '../data/roles';
import type { Certification } from '../lib/content';
import Icon from './Icon.astro';
import RoleTag from './RoleTag.astro';

interface Props {
  certs: Certification[];
  role?: RoleId | undefined;
}
const { certs, role } = Astro.props;

const groups = [
  { status: 'earned', title: 'Completed' },
  { status: 'in-progress', title: 'In progress' },
  { status: 'planned', title: 'Planned' },
] as const;

// On a role page, certifications for that role come first within each group.
const rank = (c: Certification) => (role && c.data.roles.includes(role) ? 0 : 1);
---

<div class="cert-groups">
  {
    groups.map((g) => {
      const items = certs
        .filter((c) => c.data.status === g.status)
        .sort((a, b) => rank(a) - rank(b) || a.data.order - b.data.order);
      if (items.length === 0) return null;
      return (
        <section class="cert-group" aria-labelledby={`certs-${g.status}`}>
          <h3 class="cert-group__title" id={`certs-${g.status}`}>
            {g.title}
          </h3>
          <ol class="cert-list">
            {items.map((c) => (
              <li class="cert" id={`cert-${c.data.id.toLowerCase()}`} data-draft={c.data.draft ? 'true' : undefined}>
                <span class="cert__ref">{c.data.id}</span>
                <div class="cert__body">
                  <p class="cert__name">{c.data.name}</p>
                  <p class="cert__meta">
                    {[c.data.issuer, c.data.date].filter(Boolean).join(' · ')}
                    {c.data.draft && <span class="draft-badge">Placeholder</span>}
                  </p>
                  <p class="cert__roles">
                    {c.data.roles.map((r) => (
                      <RoleTag role={r} />
                    ))}
                  </p>
                </div>
                {c.data.credentialUrl && (
                  <a class="cert__verify" href={c.data.credentialUrl}>
                    Verify<span class="visually-hidden"> {c.data.name}</span>
                    <Icon name="arrow-up-right" size={16} />
                  </a>
                )}
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }
</div>
