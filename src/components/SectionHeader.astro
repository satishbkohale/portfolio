---
/** Section heading, numbered like the clauses of a standards document. */
interface Props {
  num: string;
  title: string;
  id: string;
  intro?: string | undefined;
}
const { num, title, id, intro } = Astro.props;
---

<header class="section-header">
  <p class="section-header__num" aria-hidden="true">{num}</p>
  <div>
    <h2 class="section-header__title" id={id}>{title}</h2>
    {intro && <p class="section-header__intro">{intro}</p>}
  </div>
</header>
