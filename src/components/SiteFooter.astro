---
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const { linkedin, github, hackerrank } = site.links;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__id">
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__meta">{site.location}</p>
      <p class="site-footer__meta">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/resume/">Resume</a></li>
        <li><a href="/projects/">All projects</a></li>
        <li><a href="/security/">How this site is secured</a></li>
      </ul>
    </nav>

    <ul class="site-footer__links" aria-label="Profiles">
      {linkedin && <li><a href={linkedin} rel="noopener noreferrer">LinkedIn</a></li>}
      {github && <li><a href={github} rel="noopener noreferrer">GitHub</a></li>}
      {hackerrank && <li><a href={hackerrank} rel="noopener noreferrer">HackerRank</a></li>}
      {site.repoUrl && <li><a href={site.repoUrl} rel="noopener noreferrer">Source code</a></li>}
      <li><a href="/.well-known/security.txt">security.txt</a></li>
    </ul>
  </div>

  <div class="container site-footer__base">
    <p>© {year} {site.name}. Last updated {updated}.</p>
    <p>No cookies or tracking. Your motion setting is saved in your browser and never sent anywhere.</p>
    {site.aiAssistedNote && <p>{site.aiAssistedNote}</p>}
  </div>
</footer>
