---
/** One-line footer: identity, a few links, and the site's security posture. */
import { site } from '../data/site';

const year = new Date().getFullYear();
const { linkedin, github, hackerrank } = site.links;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__row">
      <p>© {year} {site.name} · {site.location}</p>
      <ul class="site-footer__links" aria-label="Footer">
        <li><a href="/resume/">Resume</a></li>
        <li><a href="/projects/">Projects</a></li>
        {linkedin && <li><a href={linkedin} rel="noopener noreferrer">LinkedIn</a></li>}
        {github && <li><a href={github} rel="noopener noreferrer">GitHub</a></li>}
        {hackerrank && <li><a href={hackerrank} rel="noopener noreferrer">HackerRank</a></li>}
        {site.repoUrl && <li><a href={site.repoUrl} rel="noopener noreferrer">Source</a></li>}
        <li><a href="/security/">How this site is secured</a></li>
        <li><a href="/.well-known/security.txt">security.txt</a></li>
      </ul>
      <p class="site-footer__status">Strict CSP · no cookies · no trackers</p>
    </div>
    <p class="site-footer__note">
      Your animation setting is saved in your browser and never sent anywhere.{site.aiAssistedNote && ` ${site.aiAssistedNote}`}
    </p>
  </div>
</footer>
