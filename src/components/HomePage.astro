---
/**
 * Homepage, shared by "/" (all roles) and the role pages /grc/, /iam/, /soc/.
 * Role pages reuse the same content with role-first ordering and copy.
 *
 * Order: hero, selected work (evidence first), about (the zero-trust idea),
 * skills, certifications, education, contact.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROLE_IDS, type RoleId, roles } from '../data/roles';
import { site } from '../data/site';
import { getCertifications, getEducation, getExperience, getProjects, sortForRole } from '../lib/content';
import CertList from './CertList.astro';
import ContactChannels from './ContactChannels.astro';
import CoverageTable from './CoverageTable.astro';
import Figure from './figure/Figure.astro';
import Icon from './Icon.astro';
import ProjectList from './ProjectList.astro';
import SectionHeader from './SectionHeader.astro';
import SkillsMatrix from './SkillsMatrix.astro';
import Timeline from './Timeline.astro';

interface Props {
  role?: RoleId | undefined;
}
const { role } = Astro.props;
const info = role ? roles[role] : undefined;

const projects = sortForRole(await getProjects(), role);
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const certs = await getCertifications();
const education = await getEducation();
const experience = await getExperience();

const description = info?.description ?? site.homeDescription;
const sameAs = Object.values(site.links).filter((l): l is string => Boolean(l));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: info ? info.heroRole.replace(/\.$/, '') : 'Entry-level security analyst',
    address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressCountry: 'IN' },
    knowsAbout: ['Identity and access management', 'Privileged access management', 'Security operations', 'Governance, risk and compliance'],
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
};

const lenses = [{ href: '/', label: 'All roles', id: undefined }, ...ROLE_IDS.map((r) => ({ href: `/${r}/`, label: roles[r].short, id: r }))];
const resumeHref = '/resume/';
---

<BaseLayout title={info?.pageTitle} description={description} ogType="profile" jsonLd={jsonLd}>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 class="hero__name" id="hero-title">{site.name}</h1>
        <p class="hero__role">{info?.heroRole ?? site.roleLine}</p>
        <p class="hero__value">{info?.heroValue ?? site.valueStatement}</p>

        <ul class="proof" aria-label="Highlights">
          {
            site.proofFacts.map((fact) => (
              <li class="proof__item">
                <Icon name="check" size={16} />
                <span>{fact}</span>
              </li>
            ))
          }
        </ul>

        <div class="hero__actions">
          <a class="button button--primary" href={resumeHref}>
            <Icon name="file-text" />
            <span>View resume</span>
          </a>
          <a class="button button--secondary" href="#work">
            <span>Selected work</span>
            <Icon name="arrow-right" />
          </a>
        </div>

        <dl class="doc-control">
          <div class="doc-control__row">
            <dt>Education</dt>
            <dd>{site.education.summary}{site.education.graduation ? `, graduating ${site.education.graduation}` : ''}</dd>
          </div>
          <div class="doc-control__row">
            <dt>Location</dt>
            <dd>{site.location}</dd>
          </div>
          <div class="doc-control__row">
            <dt>Roles</dt>
            <dd>{site.rolesOpenTo}</dd>
          </div>
          <div class="doc-control__row">
            <dt>Status</dt>
            <dd>{site.availability}</dd>
          </div>
        </dl>

        <nav class="lens" aria-label="View by role">
          <span class="lens__label">View by role</span>
          <ul class="lens__list">
            {
              lenses.map((l) => (
                <li>
                  <a href={l.href} aria-current={l.id === role ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="hero__figure">
        <Figure variant="hero" emphasis={info?.channel} />
      </div>
    </div>
  </section>

  <!-- 2. Selected work -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <SectionHeader num="1" id="work-title" title="Selected work" intro="Projects with what I did and what came out of it. Each one links to a short case study." />
      <ProjectList projects={featured} />
      <CoverageTable projects={projects} highlight={role} />
      <p class="section__more">
        <a class="text-link" href="/projects/">All projects and labs<Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- 3. About: the zero-trust idea, told step by step beside Fig. 2 -->
  <section class="section story" id="about" aria-labelledby="about-title">
    <div class="container story__grid">
      <div class="story__text">
        <SectionHeader num="2" id="about-title" title="About" />
        <p class="story__intro">
          I am a final-year B.Tech Computer Science and Engineering student at Nutan College of Engineering and Research, Pune, looking for an
          entry-level role in GRC, IAM or SOC L1.
        </p>

        <div class="story__steps">
          <p class="story__step" data-beat="1">
            Zero trust treats each access request as a decision. A request reaches an enforcement point and waits there until the decision is made.
          </p>
          <div class="story__step" data-beat="2" data-channel="policy">
            <h3 class="story__channel">Policy <span class="story__role">(GRC): what is allowed</span></h3>
            <p>
              My awareness platform automates the phishing simulations and follow-up emails that a security awareness programme needs. ISO/IEC
              27001 lists this kind of control under awareness, education and training.
            </p>
          </div>
          <div class="story__step" data-beat="3" data-channel="identity">
            <h3 class="story__channel">Identity <span class="story__role">(IAM): who is asking</span></h3>
            <p>
              I completed CyberArk University's introductions to privileged access management and identity security: vaults, safes, credential
              rotation and session isolation. My grounding is in Active Directory and LDAP.
            </p>
          </div>
          <div class="story__step" data-beat="4" data-channel="activity">
            <h3 class="story__channel">Activity <span class="story__role">(SOC): what is happening</span></h3>
            <p>
              I built a classifier that flags malicious URLs from their length, special characters, domain patterns and entropy. I study detection
              through MITRE ATT&amp;CK and the Cyber Kill Chain.
            </p>
          </div>
          <p class="story__step" data-beat="5">
            When the three inputs agree, the policy engine grants access, and the enforcement point opens a path with no more privilege than the
            task needs.
          </p>
          <p class="story__step" data-beat="6">
            The decision is not final. If new activity looks wrong, the session can be re-evaluated and closed. That loop between policy, identity
            and activity is the work I want to do.
          </p>
        </div>
      </div>

      <div class="story__figure">
        <Figure variant="story" emphasis={info?.channel} />
      </div>
    </div>
  </section>

  <!-- 4. Skills -->
  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="container">
      <SectionHeader
        num="3"
        id="skills-title"
        title="Skills"
        intro="Each skill is labelled by how I have used it, and links to the project or certificate that shows it."
      />
      <SkillsMatrix role={role} />
    </div>
  </section>

  <!-- 5. Certifications -->
  <section class="section" id="certifications" aria-labelledby="certs-title">
    <div class="container">
      <SectionHeader num="4" id="certs-title" title="Certifications and learning" />
      <CertList certs={certs} role={role} />
    </div>
  </section>

  <!-- 6. Education (and experience when there is some) -->
  <section class="section" id="education" aria-labelledby="education-title">
    <div class="container">
      <SectionHeader num="5" id="education-title" title={experience.length > 0 ? 'Experience and education' : 'Education'} />
      <Timeline experience={experience} education={education} />
    </div>
  </section>

  <!-- 7. Contact -->
  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <SectionHeader num="6" id="contact-title" title="Contact" />
      <ContactChannels />
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/figure';
</script>
