---
/**
 * Home pages: "/" and the role URLs /soc/, /iam/, /grc/.
 *
 *   hero     "/" gets the full pinned "Encrypt and lock" hero; the role URLs
 *            get a compact, still hero so the role content shows straight away.
 *   roles    all three role panes are in the HTML; the URL's role is active
 *            and the others are hidden. The header switcher swaps them in
 *            place (scripts/roles.ts) with real URLs and history.
 *   shared   Work, Evidence, Background and Contact, the same for every role.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_ROLE, ROLE_ORDER, type RoleId, roles } from '../data/roles';
import { site } from '../data/site';
import { getEducation, getExperience, getProjects, sortForRole } from '../lib/content';
import EvidenceLog from './EvidenceLog.astro';
import HeroLock from './HeroLock.astro';
import Icon from './Icon.astro';
import RevealLayer from './RevealLayer.astro';
import ProjectList from './ProjectList.astro';
import RolePane from './RolePane.astro';
import SectionHeader from './SectionHeader.astro';
import Timeline from './Timeline.astro';

interface Props {
  /** Set on /soc/, /iam/ and /grc/; "/" shows the default role with the full hero. */
  role?: RoleId | undefined;
}
const { role } = Astro.props;
const active = role ?? DEFAULT_ROLE;
const fullHero = !role;
const info = role ? roles[role] : undefined;

const projects = sortForRole(await getProjects(), active);
const featured = projects.filter((p) => p.data.featured).slice(0, 5);
const education = await getEducation();
const experience = await getExperience();

const description = info?.description ?? site.homeDescription;
const sameAs = Object.values(site.links).filter((l): l is string => Boolean(l));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.roleLine,
    address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressCountry: 'IN' },
    knowsAbout: ['Security operations', 'Identity and access management', 'Privileged access management', 'Governance, risk and compliance'],
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
};

const eyebrow = `${site.availability} · Pune, IN`;

/** Hero sequence: stage ids are read by src/three/hero.ts; `at` is scroll progress. */
const heroStages = [
  { id: 'plaintext', at: 0, label: 'Plaintext', caption: 'Sample records travel in the open. Anyone who intercepts them can read them.' },
  { id: 'encrypting', at: 0.12, label: 'Encrypt', caption: 'Each record is encrypted. Without the key, the characters mean nothing.' },
  { id: 'compress', at: 0.45, label: 'Compress', caption: 'The ciphertext is sealed into one encrypted block.' },
  { id: 'lock', at: 0.64, label: 'Lock', caption: 'The block goes into storage that only an authorised key can open.' },
  { id: 'locked', at: 0.86, label: 'Locked', caption: 'The data stays private, even if the storage is stolen.' },
];

const { linkedin, github } = site.links;
---

<BaseLayout title={info?.pageTitle} description={description} ogType="profile" jsonLd={jsonLd} role={active}>
  {
    fullHero ? (
      <>
  <!-- Hero: chapter 0, "Encrypt and lock". The track gives the scroll
       distance; the pin stays on screen while the 3D sequence plays. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__track" data-chapter="hero" data-stages={heroStages.map((s) => `${s.id}:${s.at}`).join(',')}>
      <div class="hero__pin" data-pin>
        <div class="container hero__grid">
          <div class="hero__text">
            <p class="hero__eyebrow">
              <span class="hero__pulse" aria-hidden="true"></span>
              <span class="visually-hidden">{eyebrow}</span>
              <span aria-hidden="true" data-decrypt>{eyebrow}</span>
            </p>
            <p class="hero__name">{site.name}</p>
            <h1 class="hero__title" id="hero-title">{site.heroTitle}</h1>
            <p class="hero__lede">{info?.heroValue ?? site.valueStatement}</p>
            <div class="hero__actions">
              <a class="button button--primary" href="/resume/">
                <Icon name="lock" size={16} />
                <span>View resume</span>
                <Icon name="arrow-right" />
              </a>
              <a class="button button--secondary" href="#contact">
                <span>Get in touch</span>
              </a>
            </div>
            <ul class="hero__facts" aria-label="Highlights">
              {site.proofFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>
          <div class="hero__visual" data-pin>
            <HeroLock />
            <ol class="sequence" aria-label="Encryption sequence">
              {
                heroStages.map((s, i) => (
                  <li class="sequence__step" data-step={s.id}>
                    <span class="sequence__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="sequence__label">{s.label}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <ol class="captions" aria-label="What the animation shows">
            {
              heroStages.map((s, i) => (
                <li class="captions__item" data-step={s.id}>
                  <span class="captions__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <p>
                    <strong>{s.label}.</strong> {s.caption}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="container hero__foot">
          <a class="hero__scroll" href={`#${active}`}>
            <span class="hero__scroll-line" aria-hidden="true"></span>
            Scroll
          </a>
          <label class="motion-switch">
            <input class="motion-switch__input" type="checkbox" role="switch" checked data-motion-toggle />
            <span class="motion-switch__track" aria-hidden="true"></span>
            <span>Animation</span>
          </label>
        </div>
      </div>
    </div>
  </section>

      </>
    ) : (
      <>
  <!-- Compact hero on the role URLs: the flat lock with its 2D loops, no pinned scroll. -->
  <section class="hero hero--compact" aria-labelledby="hero-title">
    <div class="container hero__grid">
          <div class="hero__text">
            <p class="hero__eyebrow">
              <span class="hero__pulse" aria-hidden="true"></span>
              <span class="visually-hidden">{eyebrow}</span>
              <span aria-hidden="true" data-decrypt>{eyebrow}</span>
            </p>
            <p class="hero__name">{site.name}</p>
            <h1 class="hero__title" id="hero-title">{site.heroTitle}</h1>
            <p class="hero__lede">{info?.heroValue ?? site.valueStatement}</p>
            <div class="hero__actions">
              <a class="button button--primary" href="/resume/">
                <Icon name="lock" size={16} />
                <span>View resume</span>
                <Icon name="arrow-right" />
              </a>
              <a class="button button--secondary" href="#contact">
                <span>Get in touch</span>
              </a>
            </div>
            <ul class="hero__facts" aria-label="Highlights">
              {site.proofFacts.map((fact) => <li>{fact}</li>)}
            </ul>
          </div>
          <div class="hero__visual">
            <HeroLock compact />
            <label class="motion-switch hero__motion">
              <input class="motion-switch__input" type="checkbox" role="switch" checked data-motion-toggle />
              <span class="motion-switch__track" aria-hidden="true"></span>
              <span>Animation</span>
            </label>
          </div>
    </div>
  </section>
      </>
    )
  }

  <!-- Role section: the header switcher swaps these panes. -->
  <div class="roles" data-roles data-active={active}>
    {ROLE_ORDER.map((r) => <RolePane role={r} active={r === active} />)}
  </div>
  <p class="visually-hidden" aria-live="polite" data-role-announce></p>
  <RevealLayer />

  <div class="story" data-story>
    <!-- Work -->
    <section class="story__section" id="work" aria-labelledby="work-title" data-rail>
      <div class="container story__inner">
        <SectionHeader num="01" kicker="Work" id="work-title" title="Things I've built." />
        <ProjectList projects={featured} />
        <p class="section__more">
          <a class="text-link" href="/projects/">All projects and labs<Icon name="arrow-right" size={16} /></a>
        </p>
      </div>
    </section>

    <!-- Evidence -->
    <section class="story__section" id="evidence" aria-labelledby="evidence-title" data-rail>
      <div class="container story__inner">
        <SectionHeader num="02" kicker="Evidence" id="evidence-title" title="Proof, not adjectives." />
        <EvidenceLog role={role} />
      </div>
    </section>

    <!-- Background -->
    <section class="story__section" id="background" aria-labelledby="background-title" data-rail>
      <div class="container story__inner">
        <SectionHeader
          num="03"
          kicker="Background"
          id="background-title"
          title={experience.length > 0 ? 'Experience and education.' : 'Education.'}
        />
        <div data-reveal>
          <Timeline experience={experience} education={education} />
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="story__section contact" id="contact" aria-labelledby="contact-title" data-rail>
      <div class="container story__inner">
        <SectionHeader num="04" kicker="Contact" id="contact-title" title="Let's talk." />
        <div class="contact-channels contact__body" data-reveal>
          <p class="contact__lede">Open to {site.rolesOpenTo}.</p>
          <p class="contact__secure">
            <svg class="contact__lock" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            </svg>
            <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <div class="contact__row">
            <a class="button button--primary" href={`mailto:${site.email}`}>
              <Icon name="mail" />
              <span>Email me</span>
            </a>
            <a class="button button--secondary" href={site.resumePdf.general ?? '/resume/'}>
              <Icon name={site.resumePdf.general ? 'download' : 'file-text'} />
              <span>{site.resumePdf.general ? 'Download resume' : 'Resume'}</span>
            </a>
            <button class="button button--secondary" type="button" data-copy={site.email} hidden>
              <Icon name="copy" />
              <span data-copy-label>Copy address</span>
            </button>
            {
              linkedin && (
                <a class="button button--secondary" href={linkedin} rel="noopener noreferrer">
                  LinkedIn
                  <Icon name="arrow-up-right" size={16} />
                </a>
              )
            }
            {
              github && (
                <a class="button button--secondary" href={github} rel="noopener noreferrer">
                  GitHub
                  <Icon name="arrow-up-right" size={16} />
                </a>
              )
            }
          </div>
          <p class="contact-channels__status" role="status" data-copy-status></p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/copy';
  import '../scripts/home';
  import '../scripts/roles';
</script>
