---
/**
 * Projects as numbered full-width rows: number, title, one-line outcome,
 * role tags and tools. The whole row links to the case study.
 */
import type { Project } from '../lib/content';
import Icon from './Icon.astro';
import RoleTag from './RoleTag.astro';

interface Props {
  projects: Project[];
  headingLevel?: 'h3' | 'h2';
}
const { projects, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ol class="work-list" data-reveal-group>
  {
    projects.map((p, i) => {
      const ordered = [...p.data.roles].sort((a, b) => Number(a.weight !== 'primary') - Number(b.weight !== 'primary'));
      return (
        <li class="work-row" data-reveal data-draft={p.data.draft ? 'true' : undefined}>
          <span class="work-row__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="work-row__body">
            <Heading class="work-row__title">
              <a href={`/projects/${p.id}/`}>{p.data.title}</a>
              {p.data.draft && <span class="draft-badge">Placeholder</span>}
            </Heading>
            <p class="work-row__summary">{p.data.summary}</p>
            <p class="work-row__meta">
              {ordered.map((r) => (
                <RoleTag role={r.role} weight={r.weight} />
              ))}
              <span class="work-row__tools">
                <span class="visually-hidden">Tools: </span>
                {p.data.tools.slice(0, 4).join(' · ')}
              </span>
            </p>
          </div>
          <Icon name="arrow-up-right" size={20} class="work-row__arrow" />
        </li>
      );
    })
  }
</ol>
