---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="No page exists at this address on Satish Kohale's portfolio. Go to the homepage or the project index." noindex>
  <div class="container page not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="page__title">Page not found</h1>
    <p class="page__intro">No page at this address. Try the homepage or the project index.</p>
    <div class="hero__actions">
      <a class="button button--primary" href="/"><span>Go to the homepage</span></a>
      <a class="button button--secondary" href="/projects/">
        <span>Project index</span>
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</BaseLayout>
