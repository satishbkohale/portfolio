// Cloudflare Workers static-assets deployment (no Worker script yet).
// public/_headers applies to every asset response; 404.html is served for
// unknown paths with status 404. When the contact form is added, add
// "main": "worker/index.ts" and "run_worker_first": ["/api/*"].
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "satish-kohale-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
